// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String   @default("Unknown User")
  email    String   @unique
  password String
  role     UserType @default(user)

  @@map("user")
}

enum UserType {
  admin
  user
}

model Form {
  id          Int              @id @default(autoincrement())
  formName    String
  description String
  sections    FormSection[]    @relation("FormToSection")
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("form")
}

model FormSection {
  id                 Int     @id @default(autoincrement())
  sectionName        String?
  sectionDescription String?

  form   Form @relation("FormToSection", fields: [formId], references: [id], onDelete: Cascade)
  formId Int

  fields    FormField[] @relation("FormSectionToFields")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("formsection")
}

model FormField {
  id          Int         @id @default(autoincrement())
  formSection FormSection @relation("FormSectionToFields", fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId   Int
  order       Int
  type        FieldType
  label       String
  required    Boolean     @default(false)
  placeholder String?

  // Relation to FieldResponse
  responses FieldResponse[]

  // For text fields
  multiline Boolean?

  // For radio/checkbox/table
  options FieldOption[] @relation("FieldToOptions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("formfield")
}

model FieldOption {
  id      Int       @id @default(autoincrement())
  label   String
  field   FormField @relation("FieldToOptions", fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fieldoption")
}

enum FieldType {
  text
  checkbox
  radio
  table
  select
}

model FormSubmission {
  id        Int             @id @default(autoincrement())
  form      Form            @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int
  responses FieldResponse[]
  createdAt DateTime        @default(now())
}

model FieldResponse {
  id              String         @id @default(uuid())
  submission      FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId    Int
  field           FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId         Int
  // One of the following depending on field type
  textValue       String?
  selectedOption  String? // for radio/select
  selectedOptions String[] // for checkbox
  tableValue      Json? // for table

  createdAt DateTime @default(now())
}
