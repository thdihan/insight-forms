// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  @@map("user")
}


model Form {
  id          Int      @id @default(autoincrement())
  formName    String
  description String
  fields      FormField[] @relation("FormToFields")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("form")
}

model FormField {
  id          Int            @id @default(autoincrement())
  form        Form           @relation("FormToFields", fields: [formId], references: [id])
  formId      Int
  order       Int
  type        FieldType
  label       String
  required    Boolean        @default(false)
  placeholder String?

  // For text fields
  multiline   Boolean?

  // For radio/checkbox/table
  options     FieldOption[]  @relation("FieldToOptions")

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("formfield")
}

model FieldOption {
  id        Int      @id @default(autoincrement())
  label     String
  field     FormField   @relation("FieldToOptions", fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId   Int

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("fieldoption")
}

enum FieldType {
  text
  checkbox
  radio
  table
  select
}

